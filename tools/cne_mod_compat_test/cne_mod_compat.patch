+					Std.int(parseFloat(attr(node, 'y'), 0))
+				];
+				anims.push({
+					anim: animName,
+					name: prefix,
+					fps: Std.int(fps),
+					loop: loop,
+					indices: parseNumberRange(attr(node, 'indices')),
+					offsets: offsets
+				});
+			}
+			if (anims.length == 0) return null;
+
+			var json:Dynamic = {
+				animations: anims,
+				image: image,
+				scale: scaleV,
+				sing_duration: holdTime,
+				healthicon: icon,
+				position: [posX, posY],
+				camera_position: [camX, camY],
+				flip_x: flipX,
+				no_antialiasing: !antialiasing,
