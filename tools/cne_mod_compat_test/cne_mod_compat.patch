+		#if meteoric_debug
+		if (Sys.getEnv('METEORIC_CNE_MOD_FORCE') == '1' || Sys.getEnv('METEORIC_CNE_FORCE') == '1') on = true;
+		#end
+		if (on) Sys.println('[CNE-MOD] ' + msg);
+	}
