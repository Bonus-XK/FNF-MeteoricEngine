+		var xmlPath:String = Paths.modFolders('data/characters/' + name + '.xml');
+		if (!FileSystem.exists(xmlPath)) return null;
+
+		var raw:String = null;
+		try raw = File.getContent(xmlPath) catch (e:Dynamic) { return null; }
