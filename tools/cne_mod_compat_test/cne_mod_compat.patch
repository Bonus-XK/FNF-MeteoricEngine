+		#if meteoric_debug
+		if (Sys.getEnv('METEORIC_CNE_MOD_FORCE') == '1') return true;
+		#end
+		return ClientPrefs.data != null && ClientPrefs.data.cneModCompat;
+	}
+
+	public static function log(msg:String):Void
